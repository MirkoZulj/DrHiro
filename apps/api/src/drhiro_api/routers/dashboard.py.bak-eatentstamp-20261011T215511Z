    """Weekly summary for an ISO week (YYYY-Www)."""
    from zoneinfo import ZoneInfo
    import datetime as dt

    tz = resolve_tz(user.timezone)
    try:
        year, w = week.split("-W")
        first = dt.date.fromisocalendar(int(year), int(w), 1)
    except (ValueError, AttributeError):

"""Production property test (spec defect D1c).

For the live user's top-24 logged display_names, `resolve_food(name)` MUST
return a row with that exact name first whenever a row with that exact name
exists. Run inside the API container:

    docker exec drhiro-api-1 python tests/exact_name_property.py

Exit code 0 = all exact-name cases round-trip; 1 = a regression.
"""

from __future__ import annotations

import sys

from sqlalchemy import func

from drhiro_api.db import SessionLocal
from drhiro_api.food_search import resolve_food
from drhiro_api.models import Food, MealItem, Meal

LIVE_USER_ID = "0bfad360-9938-4216-8abd-b44d69e2003f"


def main() -> int:
    db = SessionLocal()
    try:
        rows = (
            db.query(MealItem.display_name, func.count().label("c"))
            .join(Meal, Meal.id == MealItem.meal_id)
            .filter(Meal.user_id == LIVE_USER_ID)
            .group_by(MealItem.display_name)
            .order_by(func.count().desc())
            .limit(24)
            .all()
        )
        print(f"{'logged name':40} {'n':>3} {'exact row?':>10} {'resolved':52} ok")
        print("-" * 118)
        failures = 0
        checked = 0
        for name, count in rows:
            exact = (
                db.query(Food.id)
                .filter(func.lower(Food.display_name) == name.lower())
                .first()
            )
            if exact is None:
                print(f"{name:40} {count:>3} {'no':>10} {'(no exact row -> property N/A)':52} -")
                continue
            checked += 1
            res = resolve_food(db, name, limit=5, user_id=LIVE_USER_ID)
            got = res.best.display_name if res.best else "<none>"
            ok = got.lower() == name.lower()
            if not ok:
                failures += 1
            print(f"{name:40} {count:>3} {'yes':>10} {got[:52]:52} {'OK' if ok else 'FAIL'}")
        print("-" * 118)
        print(f"exact-name cases checked: {checked}; failures: {failures}")
        return 1 if failures else 0
    finally:
        db.close()


if __name__ == "__main__":
    sys.exit(main())
# (query, expected resolved name) -- expectations are exact for the fixture.
ACCEPTANCE = [
    ("banana", "Bananas, raw"),
    ("bacon", "Bacon, cooked"),
    ("water", "Water, bottled, generic"),
    ("beef", "Beef, tenderloin steak, raw"),  # never the branded row

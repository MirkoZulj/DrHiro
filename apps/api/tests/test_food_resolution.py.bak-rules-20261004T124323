def test_bare_word_rejects_qualified_and_branded_rows(db, catalogue):
    """bacon must not be 'Bacon, meatless'; water must not be 'Water convolvulus'."""
    r = resolve_food(db, "bacon", limit=5)
    assert r.best is not None
    assert r.best.display_name != "Bacon, meatless"
    assert r.best.display_name == "Bacon, cooked"

    r = resolve_food(db, "water", limit=5)
    assert r.best.display_name != "Water convolvulus, raw"
    assert "water" in r.best.display_name.lower()


def test_bare_generic_words_resolve_to_plain_rows(db, catalogue):
    for query, expected in ACCEPTANCE:
        r = resolve_food(db, query, limit=5)
        assert r.best is not None, f"{query} unresolved"
        assert r.best.display_name == expected, \
            f"{query} -> {r.best.display_name!r}, expected {expected!r}"
        # Never a branded row for a bare generic word.
        assert r.best.is_generic is True, f"{query} -> branded {r.best.display_name!r}"


def test_specific_name_is_not_collapsed_to_its_generic_word(db, catalogue):
    """A deactivated (poisoned) rule must not collapse a specific name.

    The production fix deactivates the bare-word rules that pointed at a
    branded product; here we insert the same poisoned rule as INACTIVE and
    assert it is not honoured, while a specific name still resolves to itself.
    """
    user_id = uuid.uuid4()
    db.add(User(id=user_id, display_name="Mirko", timezone="Europe/Zagreb"))
    db.flush()
    troyer = db.query(Food).filter(Food.display_name == "Troyer Dist. Co beef").one()
    db.add(FoodResolutionRule(user_id=user_id, original_pattern="beef",
                              resolved_food_id=troyer.id, scope="user", active=False))
    db.commit()

    # The bare word does not collapse to the branded row.
    r = resolve_food(db, "beef", limit=5, user_id=user_id)
    assert r.best.display_name != "Troyer Dist. Co beef"
    assert r.best.is_generic is True

    # And a specific name keeps its specificity.
    r = resolve_food(db, "Beef, tenderloin steak, raw", limit=5, user_id=user_id)
    assert r.best.display_name == "Beef, tenderloin steak, raw"


def test_head_match_plural_and_leading_tokens():
    assert _head_match("banana", "Bananas, raw") is True
    assert _head_match("banana", "Pepper, banana, raw") is False
    assert _head_match("chicken breast", "Chicken, breast, boneless, skinless, raw") is True
    assert _head_match("water", "Water, bottled, generic") is True
    assert _is_weak_head_match("bacon", "Bacon, meatless") is True
    assert _is_weak_head_match("bacon", "Bacon, cooked") is False


def test_results_are_stable_over_five_calls(db, catalogue):
    for query, _ in ACCEPTANCE:
        names = [resolve_food(db, query, limit=5).best.display_name for _ in range(5)]
        assert len(set(names)) == 1, f"{query} unstable: {names}"
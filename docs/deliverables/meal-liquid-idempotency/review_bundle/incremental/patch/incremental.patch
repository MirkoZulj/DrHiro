++def _summarize_ingress_outcome(outcome: dict) -> str:
++    """Human reply for a trusted-ingress consumption result."""
++    result = outcome.get("result") or {}
++    data = result.get("data") or {}
++    totals = data.get("totals") or {}
++    if not totals:

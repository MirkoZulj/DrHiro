++MCP_DIR = Path(__file__).resolve().parent.parent / "packages" / "drhiro-mcp" / "src"
++# The MCP server hard-codes its port to 3100 (uvicorn.run(port=3100)); probe it
++# there. This is safe in this environment (checked free).
++PORT = 3100

++            n100["kcal"] = amt
++        elif code == "protein":
++            n100["protein_g"] = amt
++        elif code == "carbs":
++            n100["carbs_g"] = amt
++        elif code == "fat":
++            n100["fat_g"] = amt
++        elif code == "fiber":
++            n100["fiber_g"] = amt
++        elif code == "sodium":
++            n100["sodium_mg"] = amt
++    item.nutrients_per_100 = n100
++    factor = (item.grams or 100) / 100.0
++    item.nutrients_scaled = _scale_nutrients(n100, factor)
++    item.source = "db"
++    item.confidence = 0.9
++

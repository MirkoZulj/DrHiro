+    db.execute(text("UPDATE meals SET totals_json = :tj, updated_at = NOW() WHERE id = :mid"), {"tj": json.dumps(tot), "mid": meal_id})
+    db.commit()
+    return {"ok": True, "item_id": item_id, "display_name": dn, "grams": grams,

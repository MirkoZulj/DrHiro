++
++def _canon_dbtype(t: str) -> str:
++    s = str(t).upper()
++    s = s.replace("CHARACTER VARYING", "VARCHAR").replace("DOUBLE PRECISION", "FLOAT")
++    s = s.replace("TIMESTAMP", "DATETIME")
++    return re.sub(r"VARCHAR\(\d+\)", "VARCHAR", s)
++
++
++def _canon_ormtype(t: str) -> str:
++    s = str(t).upper()
++    return re.sub(r"VARCHAR\(\d+\)", "VARCHAR", s)
++

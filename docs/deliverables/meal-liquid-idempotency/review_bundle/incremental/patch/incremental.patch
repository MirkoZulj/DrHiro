++    meal.totals_json = totals
++
++    # Stage 2: track whether all items have complete nutrition
++    meal_nutrition_complete = all(item.nutrition_complete for item in items)
++
++    # Update operation status and store durable result
++    op.status = "completed"
++    op.updated_at = now
++    result = {
++        "ok": True,
++        "data": {

++def _update(text: str, message_id: int = 1, user_id: int = 555, chat_id: int = -100200300):
++    return {
++        "update_id": 1,
++        "message": {
++            "message_id": message_id,
++            "chat": {"id": chat_id, "type": "private"},
++            "from": {"id": user_id, "username": "alice"},
++            "text": text,
++        },
++    }

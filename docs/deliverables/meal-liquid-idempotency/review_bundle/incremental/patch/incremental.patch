++            stripped = re.sub(re.escape(_OPENCLAW_CTX_BEGIN) + r".*?" + re.escape(_OPENCLAW_CTX_END), "", text, flags=re.DOTALL)
++            if stripped.strip():
++                continue  # block may wrap the real content; fall through below
++        if text.strip():
++            return text
++    return ""

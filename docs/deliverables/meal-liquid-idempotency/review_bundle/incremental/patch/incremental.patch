+++        """Identical text, different message ids -> two consumptions.
+++
+++        This is the case a content digest cannot distinguish; only identity can.
+++        """
+++        text = "I had 300g steak"
+++        updates = [raw_message(text, "10"), raw_message(text, "11")]
+++
+++        errors = []

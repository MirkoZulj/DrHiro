+++
+++class _Settings:
+++    def __init__(self, enabled=True, legacy=True):
+++        self.telegram_ingress_secret = "s"
+++        self.telegram_bot_id = "1"
+++        self.telegram_ingress_enabled = enabled
+++        self.legacy_consumption_writers_enabled = legacy
+++

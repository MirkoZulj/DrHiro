+++        "method,path,body,auth", GATED_ROUTES,
+++        ids=[f"{m}{p}" for m, p, _, _ in GATED_ROUTES],
+++    )
+++    def test_non_model_caller_is_not_gated(self, client, monkeypatch, method, path, body, auth):

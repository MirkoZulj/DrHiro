+    op.add_column('consumption_items', sa.Column('resolution_source', sa.String(32), nullable=True))
+    op.add_column('consumption_items', sa.Column(
+        'food_catalog_item_id', postgresql.UUID(as_uuid=True), nullable=True
+    ))

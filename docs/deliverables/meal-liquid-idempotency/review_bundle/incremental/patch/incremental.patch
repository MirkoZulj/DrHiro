+        _attach_liquid(db, user, meal, mi, "milk", "non_alcoholic", 250)
+
+        # Verify liquid exists
+        bev_count = db.query(BeverageMeasurement).filter(
+            BeverageMeasurement.user_id == user.id
+        ).count()
+        assert bev_count == 1
+        meas_count = db.query(Measurement).filter(

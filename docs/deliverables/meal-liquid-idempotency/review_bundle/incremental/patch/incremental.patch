++                meal_item_id=meal_item_id,
++                measurement_id=measurement_id,
++                consumption_item_id=ci.id,
++            )
++            db.add(bev)
++
++        item_details.append({
++            "display_name": item.display_name,
++            "grams": item.grams,
++            "volume_ml": item.volume_ml,

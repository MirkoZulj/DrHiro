+            volume_ml=i.volume_ml,
+        )
+        db.add(new_mi)
+        db.flush()
+
+        # Replicate the BeverageMeasurement + Measurement for beverage items
+        if i.beverage_category or i.volume_ml:
+            copy_beverage_link(db, user.id, str(i.id), str(new_mi.id), eaten_at)

+CHAT_ID = "-100200300"
+
+
+# ---------------------------------------------------------------------------
+# Fixtures
+# ---------------------------------------------------------------------------
+
+@pytest.fixture(scope="module")
+def engine():
+    eng = create_engine(TEST_DB_URL, pool_pre_ping=True)

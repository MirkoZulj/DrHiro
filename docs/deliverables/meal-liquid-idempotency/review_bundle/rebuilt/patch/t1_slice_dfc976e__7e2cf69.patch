+def _as_number(v, default=0):
+    if isinstance(v, (int, float)):
+        return v
+    if isinstance(v, str):
+        try:
+            return float(v.replace(",", "."))
+        except ValueError:
+            return default
+    if isinstance(v, dict):
+        for cand in v.values():
+            got = _as_number(cand, None)
+            if got is not None:
+                return got
+    return default

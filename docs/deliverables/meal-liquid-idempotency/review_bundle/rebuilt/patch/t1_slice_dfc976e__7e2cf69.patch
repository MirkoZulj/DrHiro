+        MetricType.SLEEP: "min",
+        MetricType.SPO2: "%",
+        MetricType.WEIGHT: "kg",
+        MetricType.BLOOD_PRESSURE: "mmHg",
+        MetricType.WATER: "ml",
+    }.get(metric_type)

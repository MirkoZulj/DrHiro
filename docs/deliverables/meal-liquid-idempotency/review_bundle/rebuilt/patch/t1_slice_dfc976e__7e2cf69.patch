+_MACRO_LINE_RE = re.compile(
+    r"(?P<key>kcal|calorie[s]?|protein[s]?|carb[s]?|carbohydrate[s]?|fat[s]?|fiber[s]?|fibre[s]?|sodium[mg]*)"

+def _deep_str(v):
+    seen = 0
+    while isinstance(v, dict) and seen < 5:
+        keys = list(v.keys())
+        if len(keys) == 1:
+            v = v[keys[0]]
+            seen += 1
+        else:
+            break
+    if isinstance(v, str):
+        return v.strip()
+    return ""
+

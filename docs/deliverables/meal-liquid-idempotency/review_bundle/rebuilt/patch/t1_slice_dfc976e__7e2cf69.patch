+    _tool_audit(db, user, "tools.list_reminders")
+    db.commit()
+    return ToolResponse(
+        ok=True,
+        data=[{"id": str(r.id), "type": r.type, "schedule_json": r.schedule_json, "next_due_at": r.next_due_at} for r in reminders],

+async def _resolve_meal_id(raw_id: str) -> str:
+    """If meal_id is truncated/partial, resolve to the full UUID."""
+    raw_id = (raw_id or '').strip()
+    if len(raw_id) >= 32:
+        return raw_id
+    try:
+        out = await call_api("GET", f"/meals/resolve/{raw_id}")
+        data = json.loads(out)
+        if data.get("ok"):
+            return data["meal_id"]
+    except Exception:
+        pass
+    return raw_id

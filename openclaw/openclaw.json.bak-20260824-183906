{
  "agents": {
    "defaults": {
      "workspace": "~/.openclaw/workspace/drhiro",
      "model": {
        "primary": "${OPENCLAW_MODEL}"
      },
      "models": {
        "${OPENCLAW_MODEL}": {
          "params": {
            "chat_template_kwargs": {
              "enable_thinking": false
            }
          }
        }
      }
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "qwen-local": {
        "api": "openai-completions",
        "baseUrl": "http://desktop-33cidmi:8000/v1",
        "apiKey": "local-qwen-noauth",
        "models": [
          { "id": "Qwen3.6-27B-Q4_K_M_MTP.gguf", "name": "Qwen 27B MTP (Windows box)" }
        ]
      }
    }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "botToken": "${TELEGRAM_BOT_TOKEN}",
      "dmPolicy": "pairing",
      "groupPolicy": "disabled"
    }
  },
  "mcp": {
    "servers": {
      "drhiro": {
        "command": "node",
        "args": ["/home/node/.openclaw/mcp/drhiro-mcp-server.js"],
        "transport": "stdio",
        "enabled": true,
        "env": {
          "DRHIRO_MCP_API": "${OPENCLAW_DRHIRO_API}",
          "DRHIRO_OPENCLAW_SERVICE_TOKEN": "${DRHIRO_OPENCLAW_SERVICE_TOKEN}"
        }
      }
    }
  },
  "skills": {
    "entries": {
      "skill-drhiro": {
        "enabled": true,
        "env": {
          "OPENCLAW_DRHIRO_API": "${OPENCLAW_DRHIRO_API}",
          "DRHIRO_OPENCLAW_SERVICE_TOKEN": "${DRHIRO_OPENCLAW_SERVICE_TOKEN}"
        }
      }
    }
  }
}

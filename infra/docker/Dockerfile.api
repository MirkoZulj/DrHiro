# drHiro API image
FROM python:3.12-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1

WORKDIR /app

# Install only pinned deps first for layer caching
COPY packages/health-schema /app/packages/health-schema
COPY packages/rule-engine /app/packages/rule-engine
COPY packages/nutrition-core /app/packages/nutrition-core
COPY packages/drhiro-mcp /app/packages/drhiro-mcp
COPY apps/api /app/apps/api
COPY apps/worker /app/apps/worker

RUN pip install --no-cache-dir \
    /app/packages/health-schema \
    /app/packages/rule-engine \
    /app/packages/nutrition-core \
    /app/packages/drhiro-mcp \
    /app/apps/api \
    /app/apps/worker

WORKDIR /app/apps/api
EXPOSE 8000
CMD ["uvicorn", "drhiro_api.main:app", "--host", "0.0.0.0", "--port", "8000"]

# drHiro secrets template — copy to infra/.env, fill in, NEVER commit.
# All values here are non-secret placeholders.

# --- Postgres ---
POSTGRES_USER=drhiro
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=drhiro

# --- Object storage ---
MINIO_ROOT_USER=drhiro
MINIO_ROOT_PASSWORD=change-me-minio-password

# --- API (mirrors DRHIRO_* env vars consumed by the app) ---
DRHIRO_JWT_SECRET=change-me-jwt-secret-64-chars-min
DRHIRO_TELEGRAM_BOT_TOKEN=
DRHIRO_OPENCLAW_SERVICE_TOKEN=change-me-service-token
DRHIRO_MINIAPP_ALLOWED_ORIGINS=["https://t.me"]
DRHIRO_DEBUG=false

# --- OpenClaw gateway (drHiro is an OpenClaw agent, not a Hermes subagent) ---
# Pin a real OpenClaw release tag, e.g. 2026.2.26 (no bare 'latest' in prod).
OPENCLAW_VERSION=2026.2.26
# Model the drhiro OpenClaw agent runs on, e.g. anthropic/claude-sonnet-4-6
# or an OpenAI-compatible provider you configure. Required.
OPENCLAW_MODEL=anthropic/claude-sonnet-4-6
# The same Telegram bot token the drHiro API uses for Mini App validation.
TELEGRAM_BOT_TOKEN=${DRHIRO_TELEGRAM_BOT_TOKEN}

# --- Build/release ---
GHCR_OWNER=your-org
DRHIRO_VERSION=0.1.0

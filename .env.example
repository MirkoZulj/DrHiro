# drHiro on TrueForge — environment template
# Copy to `.env`, fill in the FIVE values the installer asks for, and keep it
# private (file mode 600). All values here are non-secret placeholders.
# NEVER commit a filled .env.

# --- 1. Telegram bot token (from @BotFather) ---
# Format: 123456789:AA....  Used by the long-polling transport.
TELEGRAM_BOT_TOKEN=

# --- 2. Authorized Telegram username (without the leading @) ---
# Only this user may talk to the bot. Example: alice
TELEGRAM_ALLOWED_USERNAME=

# --- 3. OpenAI-compatible AI backend base URL ---
# The model endpoint TrueForge uses. Examples:
#   https://api.openai.com/v1
#   http://localhost:8000/v1   (local llama-server / vLLM)
AI_BACKEND_BASE_URL=

# --- 4. AI backend API key (or a local placeholder key) ---
# For a local model that ignores auth, any non-empty value works, e.g. "local".
AI_API_KEY=

# --- 5. Model name ---
# The model id advertised by the backend, e.g. gpt-4o-mini or a local .gguf name.
AI_MODEL=

# --- Advanced (optional overrides; sane defaults provided) ---
# TrueForge HTTP port
TRUEFORGE_PORT=8790
# TrueForge host port for Postgres/Redis (offset from defaults to avoid clashes)
TF_POSTGRES_PORT=5433
TF_REDIS_PORT=6380
# Where saved visit briefs are exported (inside the tools container)
EXPORT_DIR=/data/exports

# --- Android Bridge APK distribution (optional) ---
# Directory on the host holding the signed drHiro Bridge APK + apk.json sidecar.
# The installer places the APK here; the bot serves it via /apk.
APK_DIR=./apk
# Max APK size allowed for Telegram distribution (MB). The Telegram Bot API
# hard cap is 50 MB; keep the APK under this where possible.
APK_MAX_SIZE_MB=45
# Optionally pre-authorize by numeric Telegram user id (resolved automatically
# after first verified message; set explicitly to skip resolution).
TELEGRAM_ALLOWED_USER_ID=

# --- Android Bridge secure pairing (optional) ---
# Directory holding the pairing state (tokens + device registry). Must be
# writable by the bridge container.
PAIRING_STATE_DIR=/data/pairing
# Pairing token lifetime in seconds (default 10 minutes).
PAIRING_TTL_SECONDS=600
# Port the device-facing pairing HTTP server listens on (internal network).
PAIRING_HTTP_PORT=8091
# Service token protecting the pairing MANAGEMENT endpoints (/pair/devices,
# /pair/revoke). Generate a strong random value; leave blank to disable
# management over HTTP (only /pair/exchange stays open to an unpaired Bridge).
PAIRING_SERVICE_TOKEN=
# Public base URL the Android Bridge uses to reach this server for pairing
# (e.g. https://bridge.example.com). If blank, localhost:LANG fallback is used.
DRHIRO_PUBLIC_URL=
# Allow HTTP for trusted-LAN (localhost / private ranges) pairing with a visible
# warning. Set to false to require HTTPS everywhere.
PAIRING_ALLOW_HTTP_LAN=true

# drHiro — single-stack environment template.
#
# Copy to `.env`, fill in the FIVE installer inputs the installer asks for, and
# keep it private (mode 600). NEVER commit a filled .env.
#
# .env is BOOTSTRAP ONLY: install.sh writes it from the 5 inputs, first boot
# seeds the runtime settings store (app_settings table), and thereafter the
# store is the source of truth for editable settings (see the web Settings
# screen). Day-to-day changes go through the Settings screen, not this file.

# --- 1. The FIVE installer inputs (asked by install.sh) ---------------------
# Telegram bot token (from @BotFather). Used by long-polling transport.
TELEGRAM_BOT_TOKEN=
# Authorized Telegram username (without the leading @). Only this user talks to
# the bot AND may change system settings.
TELEGRAM_ALLOWED_USERNAME=
# OpenAI-compatible AI backend base URL the agent + drHiro LLM use.
AI_BACKEND_BASE_URL=
# AI backend API key (or a local placeholder key).
AI_API_KEY=
# Model name advertised by the backend (e.g. gpt-4o-mini or a local .gguf name).
AI_MODEL=

# --- 2. Shared data infrastructure ------------------------------------------
# drHiro PostgreSQL role/db (created by the postgres container on first boot).
POSTGRES_USER=drhiro
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=drhiro
# TrueForge's isolated role/db (created by infra/postgres-init on first boot).
TF_POSTGRES_USER=trueforge
TF_POSTGRES_PASSWORD=change-me-tf-password
TF_POSTGRES_DB=trueforge
# MinIO object storage (food/meal photos, exports).
MINIO_ROOT_USER=drhiro
MINIO_ROOT_PASSWORD=change-me-minio-password

# --- 3. OpenClaw gateway (Telegram comms layer) -----------------------------
# Pin a real OpenClaw release tag (no bare 'latest' in prod).
OPENCLAW_VERSION=2026.7.1-2
# Model the OpenClaw agent runs on (defaults to AI_MODEL if unset).
OPENCLAW_MODEL=
# Gateway admin token (any string; gates the OpenClaw admin UI).
OPENCLAW_GATEWAY_TOKEN=
# Service token used by OpenClaw/skills to call the drHiro Core API. Generate a
# strong random value.
DRHIRO_OPENCLAW_SERVICE_TOKEN=change-me-service-token

# --- 4. Runtime settings-apply (host-side watcher) --------------------------
# Directory (host path, bind-mounted read-write into the api container) where
# the settings-save hook writes service-name flag files. The HOST watcher reads
# these and runs `docker compose up -d --force-recreate <service>`. No container
# mounts /var/run/docker.sock.
RESTART_FLAGS_DIR=/var/lib/drhiro/restart-flags
# Log file for the host watcher (field names only, never secret values).
DRHIRO_WATCHER_LOG=/var/log/drhiro-settings-watcher.log

# --- 5. Web / reverse proxy --------------------------------------------------
# Vite build args (baked at image build): API base + SPA subpath.
VITE_API_BASE=/api/v1
VITE_BASE_PATH=/

# --- 6. Advanced / optional overrides (sane defaults) -----------------------
# TrueForge UI port
TRUEFORGE_PORT=8790
# Public base URL TrueForge advertises (blank = localhost).
PUBLIC_BASE_URL=
# Android Bridge APK distribution + pairing (see INSTALL_ANDROID_BRIDGE.md)
APK_DIR=./apk
APK_MAX_SIZE_MB=45
TELEGRAM_ALLOWED_USER_ID=
PAIRING_STATE_DIR=/data/pairing
PAIRING_TTL_SECONDS=600
PAIRING_HTTP_PORT=8091
PAIRING_SERVICE_TOKEN=
DRHIRO_PUBLIC_URL=
PAIRING_ALLOW_HTTP_LAN=true
DRHIRO_DEBUG=false
# drHiro image tag
DRHIRO_VERSION=0.1.0
